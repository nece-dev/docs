{
  "$schema": "https://mintlify.com/docs.json",
  "theme": "mint",
  "name": "OnePanel API",
  "description": "OnePanel API documentation for automated Nigerian data vending.",
  "colors": {
    "primary": "#00A878",
    "light": "#00A878",
    "dark": "#13C98B"
  },
  "favicon": "/favicon.png",
  "navigation": {
    "tabs": [
      {
        "tab": "Documentation",
        "groups": [
          {
            "group": "Start here",
            "pages": ["index", "quickstart", "authentication", "errors"]
          },
          {
            "group": "API reference",
            "openapi": "openapi.yaml"
          }
        ]
      }
    ],
    "global": {
      "anchors": [
        {
          "anchor": "OnePanel",
          "href": "https://onepanel.ng",
          "icon": "globe"
        }
      ]
    }
  },
  "logo": {
    "light": "/logo/light.png",
    "dark": "/logo/dark.png"
  },
  "navbar": {
    "links": [
      {
        "label": "OnePanel",
        "href": "https://onepanel.ng"
      }
    ],
    "primary": {
      "type": "button",
      "label": "Sign in",
      "href": "https://onepanel.ng/auth/sign-in"
    }
  },
  "contextual": {
    "options": [
      "copy",
      "view",
      "chatgpt",
      "claude",
      "perplexity",
      "mcp",
      "cursor",
      "vscode"
    ]
  },
  "footer": {
    "socials": {
      "github": "https://github.com/nece-dev"
    }
  }
}
